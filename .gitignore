# Unity project root = repository root.
# Tracked: Assets/ (incl. every .meta file), Packages/, ProjectSettings/.
# Everything else is regenerated by Unity or the IDE.

# Unity caches and per-user state (regenerated on open)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Build output (the Web build is copied into the Angular module instead)
/[Bb]uild/
/[Bb]uilds/

# IDE project files (regenerated by Unity: Preferences → External Tools)
/*.csproj
/*.sln
/*.slnx
/*.unityproj
/*.user
/*.pidb
/*.booproj
/*.svd
/*.pdb
/*.mdb
/*.opendb
/*.VC.db
/.vs/
/.idea/
/.consulo/

# Visual Studio Code: keep the shared config generated by the Unity extension
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json

# Unity crash reports and generated debug symbols
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# System files
.DS_Store
Thumbs.db
